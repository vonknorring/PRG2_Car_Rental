<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PRG_MAUI_Car_Register.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <Image Source="car.jpg"
                   Aspect="AspectFit"
                   HeightRequest="150"
                   Margin="0,0,0,20"/>

            <HorizontalStackLayout Spacing="10">
                <Entry Placeholder="Registreringsnummer"
                       Text="{Binding RegistrationNumber}" />

                <Picker Title="Välj typ"
                        ItemsSource="{Binding VehicleTypes}"
                        SelectedItem="{Binding SelectedVehicleType}" />
            </HorizontalStackLayout>

            <Entry Placeholder="Tillverkare"
                   Text="{Binding Manufacturer}" />

            <Entry Placeholder="Modell"
                   Text="{Binding Model}" />

            <Entry Placeholder="Årsmodell"
                   Text="{Binding Year}" />

            <Button Text="Registrera"
                    Command="{Binding RegisterCommand}"
                    BackgroundColor="DarkRed"
                    TextColor="White"
                    Margin="0,10"/>

            <Label Text="Kategori:" FontAttributes="Bold"/>

            <HorizontalStackLayout Spacing="10">
                <Button Text="Alla"
                        Command="{Binding FilterCommand}"
                        CommandParameter="Alla" />

                <Button Text="Bilar"
                        Command="{Binding FilterCommand}"
                        CommandParameter="Bil" />

                <Button Text="MC"
                        Command="{Binding FilterCommand}"
                        CommandParameter="MC" />

                <Button Text="Lastbil"
                        Command="{Binding FilterCommand}"
                        CommandParameter="Lastbil" />
            </HorizontalStackLayout>

            <CollectionView ItemsSource="{Binding Vehicles}"
                            Margin="0,10">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout>
                            <Label Text="{Binding RegistrationNumber}" FontAttributes="Bold"/>
                            <Label Text="{Binding Manufacturer}" />
                            <Label Text="{Binding Model}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Entry Placeholder="Sök registreringsnummer"
                   Text="{Binding RegistrationNumber}" />

            <Button Text="Sök"
                    Command="{Binding SearchCommand}"
                    BackgroundColor="DarkRed"
                    TextColor="White"/>

            <Label Text="{Binding SearchResult}"
                   TextColor="DarkRed"
                   Margin="0,10"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
